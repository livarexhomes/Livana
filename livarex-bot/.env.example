# ── Livarex WhatsApp Bot — Environment Variables ───────────────────────────
# Copy this to .env and fill in all values (never commit .env to git)

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
# Get from: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxx...              # System User permanent access token
WHATSAPP_PHONE_NUMBER_ID=1234567890    # Phone Number ID (not the actual phone number)
WHATSAPP_VERIFY_TOKEN=livarex_verify_2025  # Any secret string — used to verify the webhook URL

# ── AI (Anthropic / Claude / OpenRouter / Groq) ────────────────────────
# Primary provider: direct Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
# Secondary fallback provider: OpenRouter
OPENROUTER_API_KEY=sk-or-...
# Tertiary fallback provider: Groq (optional, add later)
GROQ_API_KEY=gsk-...

# ── Supabase (shared with the main Livarex web app) ───────────────────────
# Use the SAME values as the property-manager web app
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # Service role key (NOT the anon key)

# ── Admin notifications ────────────────────────────────────────────────────
# WhatsApp number that receives new-signup / KYC / agent-escalation alerts
# Format: country code + number, no + or spaces (e.g. 2347060528437 for Nigeria)
# The bot warns at boot if this is unset — admin alerts are silently dropped.
ADMIN_PHONE_NUMBER=2347060528437

# ── Webhook security ───────────────────────────────────────────────────────
# Set this same value in Supabase webhook headers as: x-webhook-secret
WEBHOOK_SECRET=your_random_secret_here

# ── Web Chat API (used by the livarex.com.ng chatbot widget) ───────────────
# Shared secret the widget must send in the X-Chat-Secret header on every
# /api/chat call. If unset, /api/chat returns 503 (fail-closed).
CHAT_API_SECRET=your_random_secret_here
# Comma-separated list of origins allowed to call /api/chat (CORS).
CHAT_ALLOWED_ORIGINS=https://www.livarex.com.ng,https://livarex.com.ng
# Per-IP rate limit on /api/chat (default 20 req / 60 s).
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000

PORT=3000
