# ── Livarex WhatsApp Bot — Environment Variables ───────────────────────────
# Copy this to .env and fill in all values (never commit .env to git)

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
# Get from: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxx...              # System User permanent access token
WHATSAPP_PHONE_NUMBER_ID=1234567890    # Phone Number ID (not the actual phone number)
WHATSAPP_VERIFY_TOKEN=livarex_verify_2025  # Any secret string — used to verify the webhook URL

# ── AI (Replit-managed Anthropic integration) ──────────────────────────────
# These are auto-set by Replit. No manual action needed in the Replit environment.
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=...
AI_INTEGRATIONS_ANTHROPIC_API_KEY=...

# ── Supabase (shared with the main Livarex web app) ───────────────────────
# Use the SAME values as the property-manager web app
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # Service role key (NOT the anon key)

# ── Admin notifications ────────────────────────────────────────────────────
# WhatsApp number that receives new-signup / KYC / agent-escalation alerts
# Format: country code + number, no + or spaces (e.g. 2347060528437 for Nigeria)
ADMIN_PHONE_NUMBER=2347060528437

# ── Webhook security ───────────────────────────────────────────────────────
# Set this same value in Supabase webhook headers as: x-webhook-secret
WEBHOOK_SECRET=your_random_secret_here

PORT=3000
