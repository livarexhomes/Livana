{
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/property-manager/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ]
}
